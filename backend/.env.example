NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=school_saas

JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=replace_with_generated_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_generated_vapid_private_key
VAPID_SUBJECT=mailto:admin@example.com
