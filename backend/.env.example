NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=school_saas

JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=replace_with_generated_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_generated_vapid_private_key
VAPID_SUBJECT=mailto:admin@example.com

# Get from resend.com (free tier). Unset in dev just logs instead of sending.
RESEND_API_KEY=replace_with_resend_api_key
EMAIL_FROM=MySchoolPortal <onboarding@resend.dev>

# Shared secret Vercel Cron sends as "Authorization: Bearer <this>" — generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace_with_a_long_random_string

# This backend's own public URL (not the frontend's) — MoolRe's webhook
# needs a real address to call back on, unlike frontend links which the
# browser already knows. In production this is https://api.myschoolportalgh.com.
BACKEND_URL=http://localhost:5000

# From your MoolRe dashboard (docs.moolre.com). Unset in dev just returns a
# 503 on checkout instead of crashing — no sandbox account needed to run the
# rest of the app locally.
MOOLRE_API_USER=replace_with_moolre_username
MOOLRE_API_PUBKEY=replace_with_moolre_public_api_key
MOOLRE_ACCOUNT_NUMBER=replace_with_moolre_account_number
